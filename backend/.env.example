# Backend's own bookkeeping database (project: mcp-oauth-backend, ref bbdpvukyhgybtuxhzhnx)
SUPABASE_URL=https://bbdpvukyhgybtuxhzhnx.supabase.co
# Service role key — grab from the Supabase dashboard (Project Settings > API).
# Not fetchable via MCP tools on purpose; bypasses RLS, never expose to a client.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret required on every /api/connections* route (not the callback).
# Generate with: openssl rand -hex 32
BACKEND_API_TOKEN=

# Must exactly match the redirect_uri used at DCR registration time.
# Local dev (vercel dev, default port 3000):
OAUTH_REDIRECT_URI=http://localhost:3000/api/oauth/callback
# Once deployed, switch to the deployed URL, e.g.:
# OAUTH_REDIRECT_URI=https://<your-deployment>.vercel.app/api/oauth/callback
