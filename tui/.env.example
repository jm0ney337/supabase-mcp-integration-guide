# Point at your local `vercel dev` instance, or the deployed backend URL.
BACKEND_URL=http://localhost:3000
# Must match the backend's BACKEND_API_TOKEN.
BACKEND_API_TOKEN=

# Required for the Claude Agent SDK (runs in this process, in src/agent.ts).
# Get one from https://console.anthropic.com/settings/keys
# If you're already logged into Claude Code on this machine (`claude` CLI),
# the SDK can use that session instead and this can be left blank.
ANTHROPIC_API_KEY=
